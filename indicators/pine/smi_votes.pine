//@version=6
indicator("SMI N OY", shorttitle="SMI N OY", overlay=true, dynamic_requests=true)
// Her aktif satır bir koşuldur. AL ve SAT için minimum N ayrı ayrı belirlenir.
// Puan, ağırlık ve seri birikimi yoktur. Eşiklere eşitlik dahildir.
// Sinyal yalnızca en küçük aktif TF grafiğinin kapanışında oluşur.
// Üst TF: son kapanmış EMA durumları + o ana kadar oluşmuş HTF yüksek/düşüğü.
// Sinyal, en küçük aktif TF kapanışında açık üst TF'nin o andaki SMI'sini kullanır.
// Aktif satırlar birbirinden bağımsızdır; aynı TF iki satırda seçilirse iki oy sayılır.
// Varsayılan: 1D + 3D aktif, AL N=2, SAT N=2, pencere=10, EMA1=3, EMA2=3, AL<=-40, SAT>=40.
// Sinyal çizgisi kesişimi aranmaz; oylar ana SMI'nin eşiklerine göre sayılır.
// Standart grafik kullan. Grafik TF'si en küçük aktif TF ile aynı olmalıdır.
// Bir grafik mumu HTF sınırını kesiyorsa OHLC iki parçaya ayrılamaz.
// Böyle bir HTF'nin eksik ara değerleri oy vermez; tabloda "TF sınırı" görünür.
// Yeni HTF baştan izlenebildiğinde veya tam HTF kapanışında hesap tekrar kullanılabilir.
// Açık grafikte oylar geçicidir. Veri sağlayıcısı düzeltmeleri geçmişi değiştirebilir.
// Bu gösterge emir göndermez. Varsayılanlar performans için optimize edilmedi.

const string G0 = "00 • GENEL"
int requiredBuyVotes = input.int(2, "AL için en az kaç zaman dilimi doğrulasın? (N)", minval=1, maxval=10, group=G0, tooltip="Yalnızca AL sinyali için minimum onay sayısı. Aktif satır sayısını aşarsa sadece AL sinyali oluşmaz. SAT kendi N değeriyle çalışır. Veri olmayan satır oy vermez.")
int requiredSellVotes = input.int(2, "SAT için en az kaç zaman dilimi doğrulasın? (N)", minval=1, maxval=10, group=G0, tooltip="Yalnızca SAT sinyali için minimum onay sayısı. Aktif satır sayısını aşarsa sadece SAT sinyali oluşmaz. AL kendi N değeriyle çalışır. Veri olmayan satır oy vermez.")
bool showTable = input.bool(true, "Oy tablosunu göster", group=G0)
bool onlyFirst = input.bool(false, "Sadece N şartının ilk mumunda sinyal", group=G0, tooltip="Kapalı: ilgili yönün kendi N şartı sürdükçe her en küçük TF kapanışında sinyal. Açık: AL kendi N şartına, SAT kendi N şartına ilk ulaştığında sinyal verir. Yeniden sinyal için ilgili yönün şartı önce bozulmalıdır.")

const string G1 = "01 • ZAMAN DİLİMİ 1"
bool en1 = input.bool(true, "Aktif", group=G1, inline="a1")
string tf1 = input.timeframe("1D", "TF", group=G1, inline="a1")
int len1 = input.int(10, "SMI pencere (%K)", minval=1, maxval=5000, group=G1, inline="b1", tooltip="Bu zaman diliminde en yüksek ve en düşük fiyatın aranacağı mum sayısı.")
int smoothA1 = input.int(3, "EMA 1", minval=1, maxval=5000, group=G1, inline="m1", tooltip="Kapanışın aralık ortasına uzaklığına ve aralık genişliğine uygulanan ilk EMA uzunluğu.")
int smoothB1 = input.int(3, "EMA 2", minval=1, maxval=5000, group=G1, inline="m1", tooltip="İlk EMA sonuçlarına uygulanan ikinci EMA uzunluğu. TradingView SMI %D=3 hesabı için EMA 1 ve EMA 2 değerlerini 3 yap. Bu, SMI üzerindeki ayrı bir sinyal çizgisi değildir.")
float dipThr1 = input.float(-40.0, "AL ≤", minval=-100, maxval=100, step=0.1, group=G1, inline="c1")
float topThr1 = input.float(40.0, "SAT ≥", minval=-100, maxval=100, step=0.1, group=G1, inline="c1")

const string G2 = "02 • ZAMAN DİLİMİ 2"
