// ── Zaman dilimi seçimi ───────────────────────────────────────────────────────
f_tfKey(string tf) =>
    string value = tf == "" ? timeframe.period : tf
    switch value
        "S" => "1S"
        "D" => "1D"
        "W" => "1W"
        "M" => "1M"
        => value
// Tick grafikleri saniyeye çevrilemez; sessizce yanlış hesaplamaya katılmaz.
f_seconds(simple string tf) =>
    string value = tf == "" ? timeframe.period : tf
    str.endswith(value, "T") ? float(na) : timeframe.in_seconds(value)
array<bool> enabled = array.from(en1, en2, en3, en4, en5, en6, en7, en8, en9, en10)
array<string> frames = array.from(tf1, tf2, tf3, tf4, tf5, tf6, tf7, tf8, tf9, tf10)
array<float> frameSeconds = array.from(f_seconds(tf1), f_seconds(tf2), f_seconds(tf3), f_seconds(tf4), f_seconds(tf5), f_seconds(tf6), f_seconds(tf7), f_seconds(tf8), f_seconds(tf9), f_seconds(tf10))
array<float> dipLevels = array.from(dipThr1, dipThr2, dipThr3, dipThr4, dipThr5, dipThr6, dipThr7, dipThr8, dipThr9, dipThr10)
array<float> topLevels = array.from(topThr1, topThr2, topThr3, topThr4, topThr5, topThr6, topThr7, topThr8, topThr9, topThr10)
int activeCount = 0
float minSeconds = na
string minTf = ""
bool settingsOk = true
string settingsMessage = ""
for i = 0 to 9
    if array.get(enabled, i)
        activeCount += 1
        string selectedTf = f_tfKey(array.get(frames, i))
        float seconds = array.get(frameSeconds, i)
        if na(seconds)
            settingsOk := false
            settingsMessage := "Saniye/dakika/gün/hafta/ay seç. Tick TF desteklenmez."
        else if na(minSeconds) or seconds < minSeconds
            minSeconds := seconds
            minTf := selectedTf
        if array.get(dipLevels, i) >= array.get(topLevels, i)
            settingsOk := false
            settingsMessage := "Satır " + str.tostring(i + 1) + ": AL eşiği SAT eşiğinden küçük olmalı."
// Eşit süreli farklı takvimler (ör. 7D ve 1W) aynı TF kabul edilmez.
// Böyle bir eşitlikte ilk aktif satır sinyal grafiğini belirler.
bool validChart = settingsOk and activeCount > 0 and chart.is_standard and f_tfKey(timeframe.period) == minTf

// ── Stochastic Momentum Index ve HTF snapshot ────────────────────────────────
// H = highest(high, K), L = lowest(low, K), uzaklık = close - (H + L) / 2.
// SMI = 200 * EMA(EMA(uzaklık, EMA1), EMA2) / EMA(EMA(H-L, EMA1), EMA2).
// Kaynak: https://www.tradingview.com/support/solutions/43000707882-stochastic-momentum-index-smi/
// EMA1=EMA2 olduğunda TradingView'in çift-EMA SMI formülüyle aynı yapıdadır.
// EMA başlangıcı ta.ema ile aynıdır; sıfır genişlikte tanımsız değer oy vermez.
// UDT, 10 satırın HTF durumlarını isteklerin 127 tuple öğesi sınırını aşmadan taşır.
type SmiState
    float tailHigh
    float tailLow
    float num1
    float num2
    float den1
    float den2
    int endTime
    float value

f_ratio(float numerator, float denominator) =>
    not na(numerator) and not na(denominator) and denominator > 0.0 ? 200.0 * numerator / denominator : float(na)

f_emaStep(float previous, float sample, simple int length) =>
    float alpha = 2.0 / (length + 1.0)
    na(sample) ? previous : na(previous) ? sample : alpha * sample + (1.0 - alpha) * previous

f_state(simple int length, simple int smooth1, simple int smooth2, simple bool previous) =>
    float highestHigh = ta.highest(high, length)
    float lowestLow = ta.lowest(low, length)
    float distance = close - (highestHigh + lowestLow) / 2.0
    float width = highestHigh - lowestLow
    float num1 = ta.ema(distance, smooth1)
    float num2 = ta.ema(num1, smooth2)
    float den1 = ta.ema(width, smooth1)
    float den2 = ta.ema(den1, smooth2)
    float value = f_ratio(num2, den2)
    // Son K-1 kapanmış HTF mumu + oluşmakta olan HTF mumu = yeni K penceresi.
    // K=1 olduğunda tailHigh/tailLow kullanılmaz; güvenli hesap için en az 1.
    float tailHigh = ta.highest(high, math.max(length - 1, 1))
    float tailLow = ta.lowest(low, math.max(length - 1, 1))
    int offset = previous ? 1 : 0
    SmiState.new(tailHigh[offset], tailLow[offset], num1[offset], num2[offset], den1[offset], den2[offset], time_close[offset], value[offset])

f_smi(simple bool on, simple string tf, simple int length, simple int smooth1, simple int smooth2, bool chartOk) =>
    // Geçmişe bağlı fonksiyonlar her barda çalıştırılır; çağrılar satıra özeldir.
    SmiState localState = f_state(length, smooth1, smooth2, false)
    string requestedTf = on and chartOk ? tf : "1D"
    // A paketinin TÜM öğeleri 1 HTF mumu ötelenmiştir; gelecekteki H/L alınmaz.
    SmiState a = request.security(syminfo.tickerid, requestedTf, f_state(length, smooth1, smooth2, true), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
    // B yalnızca grafik kapanışı ile HTF kapanışı aynıysa kullanılır.
    SmiState b = request.security(syminfo.tickerid, requestedTf, f_state(length, smooth1, smooth2, false), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)

    int tfStart = time(requestedTf)
    int tfEnd = time_close(requestedTf)
    var int bucketStart = na
    var float runningHigh = na
    var float runningLow = na
    var bool rangeComplete = false
    bool newBucket = na(bucketStart) or bucketStart != tfStart
    bool contained = not na(tfStart) and not na(tfEnd) and time >= tfStart and time_close <= tfEnd
    if newBucket
        bucketStart := tfStart
        runningHigh := high
        runningLow := low
        // İlk veri HTF'nin ortasından başlıyorsa eksik aralığı tam sayma.
        rangeComplete := contained and time == tfStart
    else
        runningHigh := math.max(runningHigh, high)
        runningLow := math.min(runningLow, low)
        // Bir önceki taşan mumun oluşturduğu eksiklik sonraki mumda unutulmaz.
        rangeComplete := rangeComplete and contained

    float result = na
    bool boundaryBlocked = false
    if on and chartOk
        if f_tfKey(tf) == f_tfKey(timeframe.period)
            result := localState.value
        else
            bool exactClose = not na(b) and not na(b.endTime) and b.endTime == time_close
            bool previousReady = not na(a) and not na(a.endTime) and a.endTime <= tfStart
            if exactClose
                // HTF bu mumda kapanır: native değeri kullan, EMA'yı iki kere işletme.
                result := b.value
            else if rangeComplete and previousReady
                float h = length == 1 ? runningHigh : math.max(a.tailHigh, runningHigh)
                float l = length == 1 ? runningLow : math.min(a.tailLow, runningLow)
                float distance = close - (h + l) / 2.0
                float width = h - l
                // Her snapshot son kapanmış HTF durumundan yalnızca BİR adım ilerler.
                // Ara grafik mumlarının EMA değerleri sonraki snapshot'a aktarılmaz.
                float num1Now = f_emaStep(a.num1, distance, smooth1)
                float num2Now = f_emaStep(a.num2, num1Now, smooth2)
                float den1Now = f_emaStep(a.den1, width, smooth1)
                float den2Now = f_emaStep(a.den2, den1Now, smooth2)
                result := f_ratio(num2Now, den2Now)
            else
                boundaryBlocked := not rangeComplete
    [result, boundaryBlocked]

// Her satırın TF, pencere, iki EMA uzunluğu ve eşikleri bağımsızdır.
[smi1, blocked1] = f_smi(en1, tf1, len1, smoothA1, smoothB1, validChart)
[smi2, blocked2] = f_smi(en2, tf2, len2, smoothA2, smoothB2, validChart)
[smi3, blocked3] = f_smi(en3, tf3, len3, smoothA3, smoothB3, validChart)
[smi4, blocked4] = f_smi(en4, tf4, len4, smoothA4, smoothB4, validChart)
[smi5, blocked5] = f_smi(en5, tf5, len5, smoothA5, smoothB5, validChart)
[smi6, blocked6] = f_smi(en6, tf6, len6, smoothA6, smoothB6, validChart)
[smi7, blocked7] = f_smi(en7, tf7, len7, smoothA7, smoothB7, validChart)
[smi8, blocked8] = f_smi(en8, tf8, len8, smoothA8, smoothB8, validChart)
[smi9, blocked9] = f_smi(en9, tf9, len9, smoothA9, smoothB9, validChart)
[smi10, blocked10] = f_smi(en10, tf10, len10, smoothA10, smoothB10, validChart)
array<float> smis = array.from(smi1, smi2, smi3, smi4, smi5, smi6, smi7, smi8, smi9, smi10)
array<bool> blockedRows = array.from(blocked1, blocked2, blocked3, blocked4, blocked5, blocked6, blocked7, blocked8, blocked9, blocked10)
int readyCount = 0
int dipVotes = 0
int topVotes = 0
for i = 0 to 9
    if array.get(enabled, i)
        float value = array.get(smis, i)
        if not na(value)
            readyCount += 1
            dipVotes += value <= array.get(dipLevels, i) ? 1 : 0
            topVotes += value >= array.get(topLevels, i) ? 1 : 0
// Veri olmayan satır oy vermez; diğer satırlardan ilgili yönün N onayı yeterlidir.
// Hedefler otomatik küçültülmez. Bir yönün erişilememesi diğer yönü engellemez.
bool buyThresholdReachable = activeCount >= requiredBuyVotes
bool sellThresholdReachable = activeCount >= requiredSellVotes
bool dipConsensus = validChart and buyThresholdReachable and dipVotes >= requiredBuyVotes
bool topConsensus = validChart and sellThresholdReachable and topVotes >= requiredSellVotes
bool dipSignal = barstate.isconfirmed and dipConsensus and (not onlyFirst or not dipConsensus[1])
bool topSignal = barstate.isconfirmed and topConsensus and (not onlyFirst or not topConsensus[1])
plotshape(dipSignal, title="AL • DİP", style=shape.triangleup, location=location.belowbar, color=color.lime, size=size.small, text="AL", textcolor=color.white)
plotshape(topSignal, title="SAT • TEPE", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small, text="SAT", textcolor=color.white)
// Alarm ve Veri Penceresi değerleri. Bunlar puan değil, sağlanan koşul sayısıdır.
plot(validChart ? dipVotes : na, title="AL Oy", display=display.data_window)
plot(validChart ? topVotes : na, title="SAT Oy", display=display.data_window)
plot(activeCount, title="Aktif TF", display=display.data_window)
plot(requiredBuyVotes, title="Gerekli AL N", display=display.data_window)
plot(requiredSellVotes, title="Gerekli SAT N", display=display.data_window)
alertcondition(dipSignal, title="MTF SMI • AL En Az N Oy", message="MTF SMI AL | {{ticker}} | TF: {{interval}} | Fiyat: {{close}} | AL için belirlenen minimum N onayı sağlandı.")
alertcondition(topSignal, title="MTF SMI • SAT En Az N Oy", message="MTF SMI SAT | {{ticker}} | TF: {{interval}} | Fiyat: {{close}} | SAT için belirlenen minimum N onayı sağlandı.")

// ── Oy tablosu ───────────────────────────────────────────────────────────────
var table voteTable = table.new(position.top_right, 5, 14, border_width=1)
if barstate.isfirst
    table.merge_cells(voteTable, 0, 12, 4, 12)
    table.merge_cells(voteTable, 0, 13, 4, 13)
if barstate.islast
    if not showTable
        table.clear(voteTable, 0, 0, 4, 13)
    else
        color headerBg = color.rgb(35, 42, 54)
        color neutralBg = color.new(color.black, 20)
        table.cell(voteTable, 0, 0, "TF", bgcolor=headerBg, text_color=color.white)
        table.cell(voteTable, 1, 0, "SMI*", bgcolor=headerBg, text_color=color.white)
        table.cell(voteTable, 2, 0, "AL ≤", bgcolor=headerBg, text_color=color.white)
        table.cell(voteTable, 3, 0, "SAT ≥", bgcolor=headerBg, text_color=color.white)
        table.cell(voteTable, 4, 0, "OY", bgcolor=headerBg, text_color=color.white)
        for i = 0 to 9
            bool on = array.get(enabled, i)
            float value = array.get(smis, i)
            float dipLevel = array.get(dipLevels, i)
            float topLevel = array.get(topLevels, i)
            string vote = not on ? "Kapalı" : not validChart ? "-" : array.get(blockedRows, i) ? "TF sınırı" : na(value) ? "Veri yok" : value <= dipLevel ? "AL" : value >= topLevel ? "SAT" : "Bekle"
            color rowBg = vote == "AL" ? color.new(color.green, 55) : vote == "SAT" ? color.new(color.red, 55) : neutralBg
            color txt = on ? color.white : color.gray
            table.cell(voteTable, 0, i + 1, f_tfKey(array.get(frames, i)), bgcolor=rowBg, text_color=txt)
            table.cell(voteTable, 1, i + 1, na(value) ? "-" : str.tostring(value, "#.00"), bgcolor=rowBg, text_color=txt)
            table.cell(voteTable, 2, i + 1, str.tostring(dipLevel, "#.##"), bgcolor=rowBg, text_color=txt)
            table.cell(voteTable, 3, i + 1, str.tostring(topLevel, "#.##"), bgcolor=rowBg, text_color=txt)
            table.cell(voteTable, 4, i + 1, vote, bgcolor=rowBg, text_color=txt)
        string fraction = "/" + str.tostring(activeCount)
        table.cell(voteTable, 0, 11, "En az N oy", bgcolor=headerBg, text_color=color.white)
        table.cell(voteTable, 1, 11, "AL N = " + str.tostring(requiredBuyVotes) + "\nSAT N = " + str.tostring(requiredSellVotes), bgcolor=headerBg, text_color=color.white)
        table.cell(voteTable, 2, 11, validChart ? str.tostring(dipVotes) + fraction : "-", bgcolor=headerBg, text_color=color.lime)
        table.cell(voteTable, 3, 11, validChart ? str.tostring(topVotes) + fraction : "-", bgcolor=headerBg, text_color=color.orange)
        table.cell(voteTable, 4, 11, minTf == "" ? "-" : minTf, bgcolor=headerBg, text_color=color.white)
        string status = ""
        if activeCount == 0
            status := "En az bir zaman dilimini aktif et."
        else if not settingsOk
            status := settingsMessage
        else if not chart.is_standard
            status := "Standart mum/çubuk grafiği kullan."
        else if not validChart
            status := "Sinyal için " + minTf + " grafiğini aç."
        else if not barstate.isconfirmed
            status := "Mum açık • oylar geçici, sinyal kapanışta."
        else if dipSignal and topSignal
            status := "AL + SAT • iki yön de kendi N şartını sağladı."
        else if dipSignal
            status := "AL • en az " + str.tostring(requiredBuyVotes) + " onay tamamlandı."
        else if topSignal
            status := "SAT • en az " + str.tostring(requiredSellVotes) + " onay tamamlandı."
        else if dipConsensus or topConsensus
            status := "İlgili yönün N şartı sürüyor • ilk mum filtresi açık."
        else
            status := "Onay bekleniyor • AL N = " + str.tostring(requiredBuyVotes) + " • SAT N = " + str.tostring(requiredSellVotes)

        // Uyarılar yön bazındadır; diğer yönün sinyalini engellemez.
        if settingsOk and activeCount > 0
            if not buyThresholdReachable
                status := status + "\nAL hedefi erişilemez: N = " + str.tostring(requiredBuyVotes) + ", aktif TF = " + str.tostring(activeCount) + ". AL N değerini azalt veya TF aç."
            else if validChart and readyCount < requiredBuyVotes
                status := status + "\nAL için SMI verisi yetersiz: " + str.tostring(readyCount) + " TF hazır, en az " + str.tostring(requiredBuyVotes) + " gerekli."
            if not sellThresholdReachable
                status := status + "\nSAT hedefi erişilemez: N = " + str.tostring(requiredSellVotes) + ", aktif TF = " + str.tostring(activeCount) + ". SAT N değerini azalt veya TF aç."
            else if validChart and readyCount < requiredSellVotes
                status := status + "\nSAT için SMI verisi yetersiz: " + str.tostring(readyCount) + " TF hazır, en az " + str.tostring(requiredSellVotes) + " gerekli."
        table.cell(voteTable, 0, 12, status, bgcolor=headerBg, text_color=color.white, text_size=size.small)
        table.cell(voteTable, 0, 13, "* Üst TF: snapshot SMI • TF sınırı: eksik HTF aralığı, oy yok", bgcolor=neutralBg, text_color=color.silver, text_size=size.tiny)