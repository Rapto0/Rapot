float dipTargetScore = input.float(
     29.0,
     "DİP Hedef Skoru",
     minval=0.01,
     step=0.25,
     group=G_GENERAL
)

float topTargetScore = input.float(
     29.0,
     "TEPE Hedef Skoru",
     minval=0.01,
     step=0.25,
     group=G_GENERAL
)

int maxStreak = input.int(
     0,
     "Maksimum Seri",
     minval=0,
     group=G_GENERAL,
     tooltip="0 = sınırsız. Hem DİP hem TEPE serilerine uygulanır."
)


// ============================================================================
// 1D GRAFİK KONTROLÜ
// ============================================================================
//
// Bu mimari 1 günlük grafik üzerinde çalışır.
//
// Amaç:
//
// Geçmişteki her 1D kapanışında,
// o anda açık olan 2D / 3D / 1W / 1M vb. HTF mumunun
// o günkü DEVELOPING RSI değerini yeniden üretmek.
//
// Böylece:
//
// Replay'de o gün RSI = 27
//
// fakat ay sonunda:
//
// RSI = 34
//
// olmuş olsa dahi geçmişteki o günlük snapshot
// ay sonu değeriyle değiştirilmez.
//
// ============================================================================

bool validChart = timeframe.isdaily and timeframe.multiplier == 1

if barstate.isfirst and not validChart
    runtime.error("Bu sürüm 1D grafik için tasarlanmıştır.")


