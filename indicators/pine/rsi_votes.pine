//@version=6
indicator("MTF RSI DİP + TEPE • En Az N Oy", shorttitle="RSI N OY", overlay=true, dynamic_requests=true)

// Her aktif satır bir koşuldur. AL ve SAT için minimum N ayrı ayrı belirlenir.
// Puan, ağırlık ve seri birikimi yoktur. Eşiklere eşitlik dahildir.
// Sinyal yalnızca en küçük aktif TF grafiğinin kapanışında oluşur.
// Üst TF: önceki kapanmış Wilder durumu + bu grafiğin kapanışı = snapshot RSI.

const string G0 = "00 • GENEL"
int requiredBuyVotes = input.int(2, "AL için en az kaç zaman dilimi doğrulasın? (N)", minval=1, maxval=10, group=G0, tooltip="Yalnızca AL sinyali için minimum onay sayısı. Aktif satır sayısını aşarsa sadece AL sinyali oluşmaz. SAT kendi N değeriyle çalışır. Veri olmayan satır oy vermez.")
int requiredSellVotes = input.int(2, "SAT için en az kaç zaman dilimi doğrulasın? (N)", minval=1, maxval=10, group=G0, tooltip="Yalnızca SAT sinyali için minimum onay sayısı. Aktif satır sayısını aşarsa sadece SAT sinyali oluşmaz. AL kendi N değeriyle çalışır. Veri olmayan satır oy vermez.")
bool showTable = input.bool(true, "Oy tablosunu göster", group=G0)
bool onlyFirst = input.bool(false, "Sadece N şartının ilk mumunda sinyal", group=G0, tooltip="Kapalı: ilgili yönün kendi N şartı sürdükçe her en küçük TF kapanışında sinyal. Açık: AL kendi N şartına, SAT kendi N şartına ilk ulaştığında sinyal verir. Yeniden sinyal için ilgili yönün şartı önce bozulmalıdır.")

const string G1 = "01 • ZAMAN DİLİMİ 1"
bool en1 = input.bool(true, "Aktif", group=G1, inline="a1")
string tf1 = input.timeframe("1D", "TF", group=G1, inline="a1")
int len1 = input.int(14, "RSI uzunluğu", minval=2, group=G1, inline="b1")
float dipThr1 = input.float(20.0, "AL ≤", minval=0, maxval=100, step=0.1, group=G1, inline="c1")
float topThr1 = input.float(80.0, "SAT ≥", minval=0, maxval=100, step=0.1, group=G1, inline="c1")

const string G2 = "02 • ZAMAN DİLİMİ 2"
bool en2 = input.bool(false, "Aktif", group=G2, inline="a2")
string tf2 = input.timeframe("2D", "TF", group=G2, inline="a2")
int len2 = input.int(14, "RSI uzunluğu", minval=2, group=G2, inline="b2")
float dipThr2 = input.float(20.0, "AL ≤", minval=0, maxval=100, step=0.1, group=G2, inline="c2")
float topThr2 = input.float(80.0, "SAT ≥", minval=0, maxval=100, step=0.1, group=G2, inline="c2")

const string G3 = "03 • ZAMAN DİLİMİ 3"
bool en3 = input.bool(true, "Aktif", group=G3, inline="a3")
string tf3 = input.timeframe("3D", "TF", group=G3, inline="a3")
int len3 = input.int(14, "RSI uzunluğu", minval=2, group=G3, inline="b3")
float dipThr3 = input.float(20.0, "AL ≤", minval=0, maxval=100, step=0.1, group=G3, inline="c3")
float topThr3 = input.float(80.0, "SAT ≥", minval=0, maxval=100, step=0.1, group=G3, inline="c3")

const string G4 = "04 • ZAMAN DİLİMİ 4"
bool en4 = input.bool(false, "Aktif", group=G4, inline="a4")
string tf4 = input.timeframe("4D", "TF", group=G4, inline="a4")
int len4 = input.int(14, "RSI uzunluğu", minval=2, group=G4, inline="b4")
float dipThr4 = input.float(20.0, "AL ≤", minval=0, maxval=100, step=0.1, group=G4, inline="c4")
float topThr4 = input.float(80.0, "SAT ≥", minval=0, maxval=100, step=0.1, group=G4, inline="c4")

const string G5 = "05 • ZAMAN DİLİMİ 5"
bool en5 = input.bool(false, "Aktif", group=G5, inline="a5")
string tf5 = input.timeframe("5D", "TF", group=G5, inline="a5")
int len5 = input.int(14, "RSI uzunluğu", minval=2, group=G5, inline="b5")
float dipThr5 = input.float(20.0, "AL ≤", minval=0, maxval=100, step=0.1, group=G5, inline="c5")
float topThr5 = input.float(80.0, "SAT ≥", minval=0, maxval=100, step=0.1, group=G5, inline="c5")

const string G6 = "06 • ZAMAN DİLİMİ 6"
bool en6 = input.bool(false, "Aktif", group=G6, inline="a6")
string tf6 = input.timeframe("6D", "TF", group=G6, inline="a6")
int len6 = input.int(14, "RSI uzunluğu", minval=2, group=G6, inline="b6")
float dipThr6 = input.float(20.0, "AL ≤", minval=0, maxval=100, step=0.1, group=G6, inline="c6")
float topThr6 = input.float(80.0, "SAT ≥", minval=0, maxval=100, step=0.1, group=G6, inline="c6")

const string G7 = "07 • ZAMAN DİLİMİ 7"
bool en7 = input.bool(false, "Aktif", group=G7, inline="a7")
string tf7 = input.timeframe("1W", "TF", group=G7, inline="a7")
int len7 = input.int(14, "RSI uzunluğu", minval=2, group=G7, inline="b7")
float dipThr7 = input.float(20.0, "AL ≤", minval=0, maxval=100, step=0.1, group=G7, inline="c7")
float topThr7 = input.float(80.0, "SAT ≥", minval=0, maxval=100, step=0.1, group=G7, inline="c7")

const string G8 = "08 • ZAMAN DİLİMİ 8"
bool en8 = input.bool(false, "Aktif", group=G8, inline="a8")
string tf8 = input.timeframe("2W", "TF", group=G8, inline="a8")
int len8 = input.int(14, "RSI uzunluğu", minval=2, group=G8, inline="b8")
float dipThr8 = input.float(20.0, "AL ≤", minval=0, maxval=100, step=0.1, group=G8, inline="c8")
float topThr8 = input.float(80.0, "SAT ≥", minval=0, maxval=100, step=0.1, group=G8, inline="c8")

const string G9 = "09 • ZAMAN DİLİMİ 9"
bool en9 = input.bool(false, "Aktif", group=G9, inline="a9")
string tf9 = input.timeframe("3W", "TF", group=G9, inline="a9")
int len9 = input.int(14, "RSI uzunluğu", minval=2, group=G9, inline="b9")
float dipThr9 = input.float(20.0, "AL ≤", minval=0, maxval=100, step=0.1, group=G9, inline="c9")
float topThr9 = input.float(80.0, "SAT ≥", minval=0, maxval=100, step=0.1, group=G9, inline="c9")

const string G10 = "10 • ZAMAN DİLİMİ 10"
bool en10 = input.bool(false, "Aktif", group=G10, inline="a10")
string tf10 = input.timeframe("1M", "TF", group=G10, inline="a10")
int len10 = input.int(14, "RSI uzunluğu", minval=2, group=G10, inline="b10")
float dipThr10 = input.float(20.0, "AL ≤", minval=0, maxval=100, step=0.1, group=G10, inline="c10")
float topThr10 = input.float(80.0, "SAT ≥", minval=0, maxval=100, step=0.1, group=G10, inline="c10")

// ── Zaman dilimi seçimi ───────────────────────────────────────────────────────
f_tfKey(string tf) =>
    string value = tf == "" ? timeframe.period : tf
    switch value
        "S" => "1S"
        "D" => "1D"
        "W" => "1W"
        "M" => "1M"
        => value

// Tick grafikleri saniyeye çevrilemez; sessizce yanlış hesaplamaya katılmaz.
f_seconds(simple string tf) =>
    string value = tf == "" ? timeframe.period : tf
    str.endswith(value, "T") ? float(na) : timeframe.in_seconds(value)

array<bool> enabled = array.from(en1, en2, en3, en4, en5, en6, en7, en8, en9, en10)
array<string> frames = array.from(tf1, tf2, tf3, tf4, tf5, tf6, tf7, tf8, tf9, tf10)
array<float> frameSeconds = array.from(f_seconds(tf1), f_seconds(tf2), f_seconds(tf3), f_seconds(tf4), f_seconds(tf5), f_seconds(tf6), f_seconds(tf7), f_seconds(tf8), f_seconds(tf9), f_seconds(tf10))
array<float> dipLevels = array.from(dipThr1, dipThr2, dipThr3, dipThr4, dipThr5, dipThr6, dipThr7, dipThr8, dipThr9, dipThr10)
array<float> topLevels = array.from(topThr1, topThr2, topThr3, topThr4, topThr5, topThr6, topThr7, topThr8, topThr9, topThr10)

int activeCount = 0
float minSeconds = na
string minTf = ""
bool settingsOk = true
string settingsMessage = ""

for i = 0 to 9
    if array.get(enabled, i)
        activeCount += 1
        string selectedTf = f_tfKey(array.get(frames, i))
        float seconds = array.get(frameSeconds, i)
        if na(seconds)
            settingsOk := false
            settingsMessage := "Saniye/dakika/gün/hafta/ay seç. Tick TF desteklenmez."
        else if na(minSeconds) or seconds < minSeconds
            minSeconds := seconds
            minTf := selectedTf
        if array.get(dipLevels, i) >= array.get(topLevels, i)
            settingsOk := false
            settingsMessage := "Satır " + str.tostring(i + 1) + ": AL eşiği SAT eşiğinden küçük olmalı."

// Eşit süreli farklı takvimler (ör. 7D ve 1W) aynı TF kabul edilmez.
// Böyle bir eşitlikte ilk aktif satır sinyal grafiğini belirler.
bool validChart = settingsOk and activeCount > 0 and chart.is_standard and f_tfKey(timeframe.period) == minTf

// ── RSI ve geçmişe dönük snapshot ────────────────────────────────────────────
// math.max(na, 0) = na: ilk fiyat farkını sahte sıfırla doldurmuyoruz.
f_previousState(simple int length) =>
    float delta = ta.change(close)
    float avgGain = ta.rma(math.max(delta, 0.0), length)
    float avgLoss = ta.rma(math.max(-delta, 0.0), length)
    float nativeRsi = ta.rsi(close, length)
    [close[1], avgGain[1], avgLoss[1], time_close[1], nativeRsi[1]]

f_currentState(simple int length) =>
    float delta = ta.change(close)
    float avgGain = ta.rma(math.max(delta, 0.0), length)
    float avgLoss = ta.rma(math.max(-delta, 0.0), length)
    float nativeRsi = ta.rsi(close, length)
    [close, avgGain, avgLoss, time_close, nativeRsi]

f_fromAverages(float gain, float loss) =>
    float result = na
    if not na(gain) and not na(loss)
        if gain == 0.0 and loss == 0.0
            result := na
        else if loss == 0.0
            result := 100.0
        else if gain == 0.0
            result := 0.0
        else
            result := 100.0 - 100.0 / (1.0 + gain / loss)
    result

f_rsi(simple bool on, simple string tf, simple int length, bool chartOk) =>
    float localRsi = ta.rsi(close, length)
    // CW10003 düzeltmesi: geçmişe bağlı iki hesap da her çalıştırmada çağrılır.
    // Kapalı/geçersiz satırda güvenli bir TF sorgulanır; sonuç sinyale katılmaz.
    string requestedTf = on and chartOk ? tf : "1D"
    // A: yalnızca kapanmış önceki HTF durumu; tüm öğeler [1] ofsetli.
    [aClose, aGain, aLoss, aEnd, aRsi] = request.security(syminfo.tickerid, requestedTf, f_previousState(length), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
    // B: tarihsel HTF kapanışlarını yakalar. Canlıda açık HTF içerebilir.
    // Aşağıdaki zaman kontrolü, henüz kapanmamış B durumunu sinyalden dışlar.
    [bClose, bGain, bLoss, bEnd, bRsi] = request.security(syminfo.tickerid, requestedTf, f_currentState(length), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
    float result = na
    if on and chartOk
        if f_tfKey(tf) == f_tfKey(timeframe.period)
            result := localRsi
        else
            bool aUsable = not na(aEnd) and aEnd <= time_close
            bool bUsable = not na(bEnd) and bEnd <= time_close
            bool useB = bUsable and (not aUsable or bEnd >= aEnd)
            float anchorClose = useB ? bClose : aClose
            float anchorGain = useB ? bGain : aGain
            float anchorLoss = useB ? bLoss : aLoss
            float anchorRsi = useB ? bRsi : aRsi
            int anchorEnd = useB ? bEnd : aEnd
            if aUsable or bUsable
                if anchorEnd == time_close
                    result := anchorRsi
                else if not na(anchorClose) and not na(anchorGain) and not na(anchorLoss)
                    float changeNow = close - anchorClose
                    float gainNow = (anchorGain * (length - 1) + math.max(changeNow, 0.0)) / length
                    float lossNow = (anchorLoss * (length - 1) + math.max(-changeNow, 0.0)) / length
                    result := f_fromAverages(gainNow, lossNow)
    result

// Her satır ayrı fonksiyon çağrısı: RSI uzunlukları birbirinden bağımsızdır.
float rsi1 = f_rsi(en1, tf1, len1, validChart)
float rsi2 = f_rsi(en2, tf2, len2, validChart)
float rsi3 = f_rsi(en3, tf3, len3, validChart)
float rsi4 = f_rsi(en4, tf4, len4, validChart)
float rsi5 = f_rsi(en5, tf5, len5, validChart)
float rsi6 = f_rsi(en6, tf6, len6, validChart)
float rsi7 = f_rsi(en7, tf7, len7, validChart)
float rsi8 = f_rsi(en8, tf8, len8, validChart)
float rsi9 = f_rsi(en9, tf9, len9, validChart)
float rsi10 = f_rsi(en10, tf10, len10, validChart)

array<float> rsis = array.from(rsi1, rsi2, rsi3, rsi4, rsi5, rsi6, rsi7, rsi8, rsi9, rsi10)
int readyCount = 0
int dipVotes = 0
int topVotes = 0
for i = 0 to 9
    if array.get(enabled, i)
        float value = array.get(rsis, i)
        if not na(value)
            readyCount += 1
            dipVotes += value <= array.get(dipLevels, i) ? 1 : 0
            topVotes += value >= array.get(topLevels, i) ? 1 : 0

// Veri olmayan satır oy vermez; diğer satırlardan ilgili yönün N onayı yeterlidir.
// Hedefler otomatik küçültülmez. Bir yönün erişilememesi diğer yönü engellemez.
bool buyThresholdReachable = activeCount >= requiredBuyVotes
bool sellThresholdReachable = activeCount >= requiredSellVotes
bool dipConsensus = validChart and buyThresholdReachable and dipVotes >= requiredBuyVotes
bool topConsensus = validChart and sellThresholdReachable and topVotes >= requiredSellVotes
bool dipSignal = barstate.isconfirmed and dipConsensus and (not onlyFirst or not dipConsensus[1])
bool topSignal = barstate.isconfirmed and topConsensus and (not onlyFirst or not topConsensus[1])

plotshape(dipSignal, title="AL • DİP", style=shape.triangleup, location=location.belowbar, color=color.lime, size=size.small, text="AL", textcolor=color.white)
plotshape(topSignal, title="SAT • TEPE", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small, text="SAT", textcolor=color.white)

// Alarm ve Veri Penceresi değerleri. Bunlar puan değil, sağlanan koşul sayısıdır.
plot(validChart ? dipVotes : na, title="AL Oy", display=display.data_window)
plot(validChart ? topVotes : na, title="SAT Oy", display=display.data_window)
plot(activeCount, title="Aktif TF", display=display.data_window)
plot(requiredBuyVotes, title="Gerekli AL N", display=display.data_window)
plot(requiredSellVotes, title="Gerekli SAT N", display=display.data_window)

alertcondition(dipSignal, title="MTF RSI • AL En Az N Oy", message="MTF RSI AL | {{ticker}} | TF: {{interval}} | Fiyat: {{close}} | AL için belirlenen minimum N onayı sağlandı.")
alertcondition(topSignal, title="MTF RSI • SAT En Az N Oy", message="MTF RSI SAT | {{ticker}} | TF: {{interval}} | Fiyat: {{close}} | SAT için belirlenen minimum N onayı sağlandı.")

// ── Oy tablosu ───────────────────────────────────────────────────────────────
var table voteTable = table.new(position.top_right, 5, 14, border_width=1)
if barstate.isfirst
    table.merge_cells(voteTable, 0, 12, 4, 12)
    table.merge_cells(voteTable, 0, 13, 4, 13)

if barstate.islast
    if not showTable
        table.clear(voteTable, 0, 0, 4, 13)
    else
        color headerBg = color.rgb(35, 42, 54)
        color neutralBg = color.new(color.black, 20)
        table.cell(voteTable, 0, 0, "TF", bgcolor=headerBg, text_color=color.white)
        table.cell(voteTable, 1, 0, "RSI*", bgcolor=headerBg, text_color=color.white)
        table.cell(voteTable, 2, 0, "AL ≤", bgcolor=headerBg, text_color=color.white)
        table.cell(voteTable, 3, 0, "SAT ≥", bgcolor=headerBg, text_color=color.white)
        table.cell(voteTable, 4, 0, "OY", bgcolor=headerBg, text_color=color.white)
        for i = 0 to 9
            bool on = array.get(enabled, i)
            float value = array.get(rsis, i)
            float dipLevel = array.get(dipLevels, i)
            float topLevel = array.get(topLevels, i)
            string vote = not on ? "Kapalı" : not validChart ? "-" : na(value) ? "Veri yok" : value <= dipLevel ? "AL" : value >= topLevel ? "SAT" : "Bekle"
            color rowBg = vote == "AL" ? color.new(color.green, 55) : vote == "SAT" ? color.new(color.red, 55) : neutralBg
            color txt = on ? color.white : color.gray
            table.cell(voteTable, 0, i + 1, f_tfKey(array.get(frames, i)), bgcolor=rowBg, text_color=txt)
            table.cell(voteTable, 1, i + 1, na(value) ? "-" : str.tostring(value, "#.00"), bgcolor=rowBg, text_color=txt)
            table.cell(voteTable, 2, i + 1, str.tostring(dipLevel, "#.##"), bgcolor=rowBg, text_color=txt)
            table.cell(voteTable, 3, i + 1, str.tostring(topLevel, "#.##"), bgcolor=rowBg, text_color=txt)
            table.cell(voteTable, 4, i + 1, vote, bgcolor=rowBg, text_color=txt)
        string fraction = "/" + str.tostring(activeCount)
        table.cell(voteTable, 0, 11, "En az N oy", bgcolor=headerBg, text_color=color.white)
        table.cell(voteTable, 1, 11, "AL N = " + str.tostring(requiredBuyVotes) + "\nSAT N = " + str.tostring(requiredSellVotes), bgcolor=headerBg, text_color=color.white)
        table.cell(voteTable, 2, 11, validChart ? str.tostring(dipVotes) + fraction : "-", bgcolor=headerBg, text_color=color.lime)
        table.cell(voteTable, 3, 11, validChart ? str.tostring(topVotes) + fraction : "-", bgcolor=headerBg, text_color=color.orange)
        table.cell(voteTable, 4, 11, minTf == "" ? "-" : minTf, bgcolor=headerBg, text_color=color.white)
        string status = ""
        if activeCount == 0
            status := "En az bir zaman dilimini aktif et."
        else if not settingsOk
            status := settingsMessage
        else if not chart.is_standard
            status := "Standart mum/çubuk grafiği kullan."
        else if not validChart
            status := "Sinyal için " + minTf + " grafiğini aç."
        else if not barstate.isconfirmed
            status := "Mum açık • oylar geçici, sinyal kapanışta."
        else if dipSignal and topSignal
            status := "AL + SAT • iki yön de kendi N şartını sağladı."
        else if dipSignal
            status := "AL • en az " + str.tostring(requiredBuyVotes) + " onay tamamlandı."
        else if topSignal
            status := "SAT • en az " + str.tostring(requiredSellVotes) + " onay tamamlandı."
        else if dipConsensus or topConsensus
            status := "İlgili yönün N şartı sürüyor • ilk mum filtresi açık."
        else
            status := "Onay bekleniyor • AL N = " + str.tostring(requiredBuyVotes) + " • SAT N = " + str.tostring(requiredSellVotes)

        // Uyarılar yön bazındadır; diğer yönün sinyalini engellemez.
        if settingsOk and activeCount > 0
            if not buyThresholdReachable
                status := status + "\nAL hedefi erişilemez: N = " + str.tostring(requiredBuyVotes) + ", aktif TF = " + str.tostring(activeCount) + ". AL N değerini azalt veya TF aç."
            else if validChart and readyCount < requiredBuyVotes
                status := status + "\nAL için veri yetersiz: " + str.tostring(readyCount) + " TF hazır, en az " + str.tostring(requiredBuyVotes) + " gerekli."
            if not sellThresholdReachable
                status := status + "\nSAT hedefi erişilemez: N = " + str.tostring(requiredSellVotes) + ", aktif TF = " + str.tostring(activeCount) + ". SAT N değerini azalt veya TF aç."
            else if validChart and readyCount < requiredSellVotes
                status := status + "\nSAT için veri yetersiz: " + str.tostring(readyCount) + " TF hazır, en az " + str.tostring(requiredSellVotes) + " gerekli."
        table.cell(voteTable, 0, 12, status, bgcolor=headerBg, text_color=color.white, text_size=size.small)
        table.cell(voteTable, 0, 13, "* Üst TF: bu mum kapanışındaki snapshot RSI", bgcolor=neutralBg, text_color=color.silver, text_size=size.tiny)