# Optional: used only when Telegram is selected on a website server alarm.
# Empty values do not prevent the API or website from starting.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

BINANCE_API_KEY=
BINANCE_SECRET_KEY=

# Trading middleware Binance Spot settings
MW_BROKER_NAME=BINANCE_SPOT
MW_EXECUTION_MODE=DRY_RUN
MW_TRADING_ENABLED=false
MW_BINANCE_LIVE_ENABLED=false
MW_BINANCE_BASE_URL=https://testnet.binance.vision
MW_BINANCE_API_KEY=
MW_BINANCE_SECRET_KEY=
MW_BINANCE_BUY_QUOTE_AMOUNT_USDT=10
MW_BINANCE_QUOTE_ASSET=USDT
# Optional middleware guard rails. Leave unset to buy while Binance balance allows.
# MW_MAX_SYMBOL_EXPOSURE_USDT=100
# MW_MAX_DAILY_LOSS_USDT=50
# MW_MAX_OPEN_TRANCHES_PER_SYMBOL=200

# Optional manual website AI; no scheduled scanner/news/Telegram AI runs.
GEMINI_API_KEY=

AI_ENABLED=1
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash
AI_ENABLE_FALLBACK=false
AI_FALLBACK_MODEL=
AI_TIMEOUT=30
AI_TEMPERATURE=0.2
AI_THINKING_BUDGET=0
AI_MAX_OUTPUT_TOKENS=2048

# Database: use DATABASE_URL for Postgres/MySQL, otherwise SQLite path
DATABASE_URL=
DATABASE_PATH=trading_bot.db
CACHE_DATABASE_PATH=price_cache.db

# Public Borsapy/Doviz.com calendar; no Finnhub key is needed.
CALENDAR_CACHE_SECONDS=60

APP_ENV=production

# Browser-independent alarm engines run inside the API.
SERVER_ALARMS_ENABLED=true
ADVANCED_ALARMS_ENABLED=true
ADVANCED_ALARM_MARKET_ENABLED=true
ADVANCED_ALARM_ALL_BIST_ENABLED=true
BORSAPY_USE_FOR_BIST=true
# Configure the encrypted TradingView connection in /research as an admin.
# Optional private paths default beside DATABASE_PATH; never place them in Git.
# BORSAPY_CREDENTIALS_PATH=/absolute/private/path/credentials.enc
# ADVANCED_ALARM_CACHE_PATH=/absolute/private/path/advanced-alarm-market.sqlite3

# REQUIRED in production: do not keep placeholder values.
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=REPLACE_WITH_STRONG_RANDOM_64_HEX_SECRET
JWT_EXPIRE_MINUTES=1440
ALLOW_INSECURE_JWT_SECRET=0

# Set a password or hash for each account you want to enable.
# Empty credentials disable that account. Never commit real passwords.
ADMIN_PASSWORD=
USER_PASSWORD=
ADMIN_PASSWORD_HASH=
USER_PASSWORD_HASH=

# CORS (comma-separated)
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=1
